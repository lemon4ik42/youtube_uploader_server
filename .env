# Server security
APP_SECRET_KEY=dev-secret-key-change-in-production
API_TOKEN=123

HOST=0.0.0.0
PORT=8000

#BASE_DIR
# Database
#DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# YouTube read/delete API base (upload/auth endpoints are configured per project)
YOUTUBE_API_SERVICE_BASE=https://www.googleapis.com/youtube/v3

# Quota
YOUTUBE_QUOTA_LIMIT=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600

# Upload behavior
MAX_UPLOAD_MEMORY_BYTES=536870912
UPLOAD_CHUNK_SIZE_BYTES=5242880
MAX_CONCURRENT_UPLOADS_PER_CHANNEL=200
CHANNEL_SCAN_INTERVAL_SECONDS=10
MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=30
PAUSE_ON_UPLOAD_LIMIT_MINUTES=60
